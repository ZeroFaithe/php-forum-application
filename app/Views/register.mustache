{{> header}}
<h1>Create an account</h1>
{{> errors}}
<form method="post" action="{{base}}/register" class="auth-form">
  <input type="hidden" name="_token" value="{{csrf}}">
  <label for="username">Username</label>
  <input id="username" name="username" value="{{old.username}}" required minlength="3" maxlength="30"
         pattern="[A-Za-z0-9_]{3,30}" autocomplete="username">
  <small>3–30 letters, numbers or underscores.</small>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" value="{{old.email}}" required maxlength="254" autocomplete="email">

  <label for="password">Password</label>
  <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password">

  <label for="password_confirmation">Confirm password</label>
  <input id="password_confirmation" name="password_confirmation" type="password" required minlength="8" autocomplete="new-password">

  <button type="submit">Register</button>
</form>
<p>Already have an account? <a href="{{base}}/login">Log in</a></p>
{{> footer}}
